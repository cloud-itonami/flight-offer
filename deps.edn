{:paths ["src"]
 ;; Frontend deps (shadow-cljs :cljs alias). appkit transitively pulls
 ;; kotoba-ui → liquid-glass-ui → shitsuke — same convention as
 ;; orgs/kotoba-lang/murakumo-studio/deps.edn (:dev overrides to sibling
 ;; local/root checkouts inside the west superproject).
 ;; NOTE: the ../../kotoba-lang/appkit path resolves when this repo is
 ;; checked out as orgs/cloud-itonami/flight-offer in the west superproject;
 ;; override with :dev aliases to sibling local/root checkouts elsewhere.
 :aliases
 {:cljs
  {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.20"}
                reagent/reagent {:mvn/version "1.2.0"}
                io.github.kotoba-lang/appkit {:local/root "../../kotoba-lang/appkit"}}}}}
